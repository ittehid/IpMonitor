<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IpMonitor</AssemblyName>
    <RootNamespace>IpMonitor</RootNamespace>
    <Version>2.0.29</Version>
    <Authors>Alexandr Gedz</Authors>
    <Product>IP Monitor</Product>
    <Description>Compact local host availability monitor</Description>
    <ApplicationIcon>Assets\IpMonitor.ico</ApplicationIcon>
  </PropertyGroup>
<ItemGroup>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="HostForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="HostForm.Designer.cs"><DependentUpon>HostForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="HostForm.resx"><DependentUpon>HostForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="EventsForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="EventsForm.Designer.cs"><DependentUpon>EventsForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="EventsForm.resx"><DependentUpon>EventsForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="QuickAddForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="QuickAddForm.Designer.cs"><DependentUpon>QuickAddForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="QuickAddForm.resx"><DependentUpon>QuickAddForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="SettingsForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="SettingsForm.Designer.cs"><DependentUpon>SettingsForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="SettingsForm.resx"><DependentUpon>SettingsForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="AboutForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="AboutForm.Designer.cs"><DependentUpon>AboutForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="AboutForm.resx"><DependentUpon>AboutForm.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
